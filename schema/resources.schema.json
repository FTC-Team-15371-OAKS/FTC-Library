{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FTC-Team-15371-OAKS/FTC-Library/schema/resources.schema.json",
  "title": "FTC-Library resource library",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updated", "categories", "resources"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "icon", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "enum": ["portfolio", "cad", "programming", "electronics", "documentation", "tools"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "category",
        "season",
        "teamNumber",
        "teamName",
        "source",
        "attribution",
        "license",
        "tags",
        "links",
        "files",
        "addedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 96
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "season": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "teamNumber": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{1,6}$"
        },
        "teamName": {
          "type": ["string", "null"],
          "maxLength": 120
        },
        "source": {
          "type": ["string", "null"],
          "format": "uri",
          "pattern": "^https?://"
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "tags": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "maxLength": 40
              }
            }
          }
        },
        "addedAt": {
          "type": "string",
          "format": "date"
        }
      }
    }
  }
}
